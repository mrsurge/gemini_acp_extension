{
  "schema_version": 1,
  "id": "gemini-acp",
  "name": "Gemini ACP",
  "version": "0.1.2",
  "type": "gemini_acp",
  "compat": {
    "app_server_manifest_min": 1,
    "app_server_manifest_max": 1
  },
  "description": "Gemini ACP scaffold extension for multi-root loader testing.",
  "enabled": true,
  "agent": {
    "command": "gemini",
    "args": ["--acp"],
    "shellspec": "shellspec/gemini_acp.yaml#gemini_acp_observed"
  },
  "capabilities": {
    "sessionResume": true,
    "streaming": false,
    "modelListing": true,
    "permissionHandling": true,
    "hasPlan": false,
    "hasTodo": false,
    "hasPlanModes": false
  },
  "dependencies": {
    "has_check": true,
    "has_install": false
  },
  "model": {
    "name": "gemini-2.5-pro",
    "provider": "google"
  },
  "ui": {
    "color": "#4285f4",
    "semanticShellRibbon": {
      "quoteParsing": false
    }
  }
}
