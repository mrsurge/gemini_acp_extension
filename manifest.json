{
  "schema_version": 1,
  "id": "gemini-acp",
  "name": "Gemini ACP",
  "version": "0.1.6",
  "type": "gemini_acp",
  "compat": {
    "app_server_manifest_min": 1,
    "app_server_manifest_max": 1
  },
  "description": "Gemini ACP extension via framework-shells and the ACP Python SDK.",
  "enabled": true,
  "agent": {
    "command": "gemini",
    "args": ["--acp"],
    "shellspec": "shellspec/gemini_acp.yaml#gemini_acp_observed"
  },
  "capabilities": {
    "sessionResume": false,
    "streaming": false,
    "modelListing": true,
    "permissionHandling": true,
    "hasPlan": false,
    "hasTodo": false,
    "hasPlanModes": false
  },
  "dependencies": {
    "has_check": true,
    "has_install": false
  },
  "model": {
    "name": "gemini-2.5-pro",
    "provider": "google"
  },
  "ui": {
    "color": "#4285f4",
    "semanticShellRibbon": {
      "quoteParsing": false
    },
    "requestCards": [
      {
        "id": "gemini-acp-permission-request",
        "module": "ui/request_cards/gemini_request_card.js",
        "export": "renderRequestCard",
        "matches": [
          {
            "requestMethod": "gemini-acp/permission"
          }
        ]
      }
    ]
  }
}
